[Unit]
Description=Actual Budget folder importer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/opt/actual-importer
EnvironmentFile=/opt/actual-importer/.env
ExecStart=/usr/bin/node /opt/actual-importer/importer.mjs
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
