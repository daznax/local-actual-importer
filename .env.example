# Actual server
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_PASSWORD=password123
# Settings > Advanced settings > Sync ID
ACTUAL_SYNC_ID=00000000-0000-0000-0000-000000000000

# Local cache for the budget file
ACTUAL_DATA_DIR=/var/lib/actual-importer

# Folder root (wip/ complete/ failed/ live under this)
SHARED_DIR=/shared/drive/folder/to/start/with
BASE_DIR=/where/are/your/files/for/this/going

# Push notification (ntfy.sh or self-hosted). Use a long random topic name.
NTFY_URL=https://ntfy.sh/replace-with-a-long-random-topic
#NTFY_TOKEN=
